+namespace orb_slam3_integration {
+
+Vector9 step(const Vector9& state, const Vector3& acceleration,
+             const Vector3& angularVelocity) {
+  return TangentPreintegration::UpdatePreintegratedOrbSlam3(
+      acceleration, angularVelocity, kDt, state);
+}
+
+// Checks the start-attitude transition and its zero direct gyro-to-translation terms.
+TEST(TangentPreintegration, OrbSlam3UpdateJacobians) {
+  const Vector3 acceleration{0.3, -0.4, 9.7}, angularVelocity{0.7, -0.5, 0.9};
+  const Vector9 state{0.3, -0.2, 0.4, 1., 2., 3., -0.1, 0.2, -0.3};
+  Matrix9 A;
+  Matrix93 B, C;
+  const Vector9 result = TangentPreintegration::UpdatePreintegratedOrbSlam3(
+      acceleration, angularVelocity, kDt, state, A, B, C);
+  EXPECT(assert_equal(numericalDerivative31(step, state, acceleration, angularVelocity), A, 1e-8));
+  EXPECT(assert_equal(numericalDerivative32(step, state, acceleration, angularVelocity), B, 1e-8));
+  EXPECT(assert_equal(numericalDerivative33(step, state, acceleration, angularVelocity), C, 1e-8));
+  const Rot3 rotation = Rot3::Expmap(state.head<3>());
+  const Vector3 rotated = rotation.rotate(acceleration);
+  const Vector3 expectedVelocity = state.tail<3>() + rotated * kDt;
+  const Vector3 actualVelocity = result.tail<3>();
+  EXPECT(assert_equal(expectedVelocity, actualVelocity, 1e-12));
+  EXPECT(C.bottomRows<3>().norm() == 0.);
+}
+
+// Checks accumulated accelerometer and gyro bias derivatives after many steps.
+TEST(TangentPreintegration, OrbSlam3BiasJacobians) {
+  auto params = testing::Params();
+  params->setUseOrbSlam3Integration(true);
+  testing::SomeMeasurements measurements;
+  auto integrate = [&](const Vector3& accelerationBias, const Vector3& gyroBias) {
+    TangentPreintegration pim(params, Bias(accelerationBias, gyroBias));
+    testing::integrateMeasurements(measurements, &pim);
+    return pim.preintegrated();
+  };
+  TangentPreintegration pim(params);
+  testing::integrateMeasurements(measurements, &pim);
+  const Vector3 zero = Vector3::Zero();
+  EXPECT(assert_equal(numericalDerivative21<Vector9, Vector3, Vector3>(integrate, zero, zero),
+                      pim.preintegrated_H_biasAcc(), 1e-7));
+  EXPECT(assert_equal(numericalDerivative22<Vector9, Vector3, Vector3>(integrate, zero, zero),
+                      pim.preintegrated_H_biasOmega(), 1e-7));
+}
