+//------------------------------------------------------------------------------
+Vector9 TangentPreintegration::UpdatePreintegratedMidpoint(
+    const Vector3& a_body, const Vector3& w_body, double dt,
+    const Vector9& preintegrated, OptionalJacobian<9, 9> A,
+    OptionalJacobian<9, 3> B, OptionalJacobian<9, 3> C) {
+  Matrix3 rotation_H_theta, increment_H_omega, half_H_omega, log_H_rotation;
+  const Rot3 rotation = Rot3::Expmap(preintegrated.head<3>(), rotation_H_theta);
+  const Rot3 increment = Rot3::Expmap(w_body * dt, increment_H_omega);
+  const Rot3 half = Rot3::Expmap(w_body * (0.5 * dt), half_H_omega);
+  const Vector3 nextTheta = Rot3::Logmap(rotation * increment, log_H_rotation);
+  const Matrix3 midpointRotation = rotation.matrix() * half.matrix();
+  const Vector3 acceleration = midpointRotation * a_body;
+  const double halfDtSquared = 0.5 * dt * dt;
+
+  Vector9 result;
+  result << nextTheta,
+      preintegrated.segment<3>(3) + preintegrated.tail<3>() * dt +
+          acceleration * halfDtSquared,
+      preintegrated.tail<3>() + acceleration * dt;
+  if (A) {
+    const Matrix3 acceleration_H_theta =
+        -rotation.matrix() * skewSymmetric(half.rotate(a_body)) * rotation_H_theta;
+    A->setIdentity();
+    A->block<3, 3>(0, 0) =
+        log_H_rotation * increment.matrix().transpose() * rotation_H_theta;
+    A->block<3, 3>(3, 0) = acceleration_H_theta * halfDtSquared;
+    A->block<3, 3>(3, 6) = I_3x3 * dt;
+    A->block<3, 3>(6, 0) = acceleration_H_theta * dt;
+  }
+  if (B) {
+    B->topRows<3>().setZero();
+    B->middleRows<3>(3) = midpointRotation * halfDtSquared;
+    B->bottomRows<3>() = midpointRotation * dt;
+  }
+  if (C) {
+    const Matrix3 acceleration_H_omega =
+        -midpointRotation * skewSymmetric(a_body) * half_H_omega * (0.5 * dt);
+    C->topRows<3>() = log_H_rotation * increment_H_omega * dt;
+    C->middleRows<3>(3) = acceleration_H_omega * halfDtSquared;
+    C->bottomRows<3>() = acceleration_H_omega * dt;
+  }
+  return result;
+}
