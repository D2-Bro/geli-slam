Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: gelslam_gravity_aligned
      Cell Size: 0.01
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Global Surface
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 170; 180; 190
      Topic:
        Value: /gelslam/rviz/global_surface
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Current Tactile Surface
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Topic:
        Value: /gelslam/rviz/current_surface
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GelSight Trajectory
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.003
      Topic:
        Value: /gelslam/rviz/gelsight_trajectory
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Estimated Frames
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
      Marker Scale: 0.01
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Bag GelSight Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gelsight/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: GelSight Normal Map
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gelslam/rviz/normal_map
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Normal Point Correspondences
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gelslam/rviz/normal_correspondences
  Global Options:
    Fixed Frame: gelslam_gravity_aligned
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # Keep the camera fixed in the gravity-aligned display frame.
      Target Frame: gelslam_gravity_aligned
      Distance: 0.12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
