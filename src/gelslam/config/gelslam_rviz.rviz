Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: gelslam_map
      Cell Size: 0.01
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Global Mesh
      Topic:
        Value: /gelslam/rviz/global_mesh
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Current Tactile Patch
      Topic:
        Value: /gelslam/rviz/current_mesh
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Estimated Frames
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
      Marker Scale: 0.01
  Global Options:
    Fixed Frame: gelslam_map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: gelsight_estimate
      Distance: 0.12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
